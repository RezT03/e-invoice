# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=password
DB_NAME=e_invoice
DB_PORT=3306

# Server
PORT=3000
NODE_ENV=development

# Session
SESSION_SECRET=your-secret-key-here-change-this-in-production

# Optional
APP_NAME=E-Invoice Restu Production
APP_URL=http://localhost:3000

# ==== Google Calendar (Service Account, tanpa OAuth) ====
# Kalender bersama harus dibagikan ke email service account dengan
# permission "Make changes to events".
GOOGLE_CALENDAR_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=nama-service-account@project-id.iam.gserviceaccount.com
# Private key dari file JSON service account. Tulis dalam satu baris,
# baris baru direpresentasikan sebagai \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Zona waktu event (opsional, default Asia/Jakarta)
CALENDAR_TIMEZONE=Asia/Jakarta

# Alternatif: satu variabel berisi path file JSON atau JSON mentah.
# Jika diisi, GOOGLE_SERVICE_ACCOUNT_EMAIL dan GOOGLE_PRIVATE_KEY diabaikan.
# GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json
