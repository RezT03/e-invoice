<aside class="sidebar" id="sidebar">
	<div class="sidebar-header">
		<h2>E-Invoice</h2>
		<p>Restu Production</p>
	</div>

	<% 
		const activeDocType = typeof document_type !== 'undefined' ? document_type : (typeof docType !== 'undefined' ? docType : '');
	%>
	<nav class="sidebar-nav">
		<div class="nav-section-label">Utama</div>
		<a
			href="/admin/invoice/dashboard"
			class="nav-item <%= currentPage === 'dashboard' ? 'active' : '' %>"
		>
			<span class="icon"><i class="fa-solid fa-chart-bar"></i></span>
			<span class="label">Dashboard</span>
		</a>

		<div class="nav-section-label">Dokumen</div>
		<a
			href="/admin/invoice/create"
			class="nav-item <%= currentPage === 'create' ? 'active' : '' %>"
		>
			<span class="icon"><i class="fa-solid fa-plus"></i></span>
			<span class="label">Buat Baru</span>
		</a>
		<a
			href="/admin/invoice/history?document_type=invoice"
			class="nav-item <%= currentPage === 'history' && activeDocType !== 'quotation' ? 'active' : '' %>"
		>
			<span class="icon"><i class="fa-regular fa-file-lines"></i></span>
			<span class="label">Invoice</span>
		</a>
		<a
			href="/admin/invoice/history?document_type=quotation"
			class="nav-item <%= currentPage === 'history' && activeDocType === 'quotation' ? 'active' : '' %>"
		>
			<span class="icon"><i class="fa-solid fa-hand-holding-dollar"></i></span>
			<span class="label">Penawaran Harga</span>
		</a>

		<div class="nav-section-label">Master Data</div>
		<a
			href="/admin/products"
			class="nav-item <%= currentPage === 'products' ? 'active' : '' %>"
		>
			<span class="icon"><i class="fa-solid fa-boxes-stacked"></i></span>
			<span class="label">Produk &amp; Stok</span>
		</a>
		<a
			href="/admin/customers"
			class="nav-item <%= currentPage === 'customers' ? 'active' : '' %>"
		>
			<span class="icon"><i class="fa-solid fa-users"></i></span>
			<span class="label">Pelanggan</span>
		</a>

		<div class="nav-section-label">Operasional</div>
		<a
			href="/admin/bookings"
			class="nav-item <%= currentPage === 'bookings' ? 'active' : '' %>"
		>
			<span class="icon"><i class="fa-regular fa-calendar-check"></i></span>
			<span class="label">Jadwal &amp; Booking</span>
		</a>
		<a
			href="/admin/deliveries"
			class="nav-item <%= currentPage === 'deliveries' ? 'active' : '' %>"
		>
			<span class="icon"><i class="fa-solid fa-truck-fast"></i></span>
			<span class="label">Surat Jalan</span>
		</a>

		<div class="nav-section-label">Keuangan</div>
		<a
			href="/admin/payments"
			class="nav-item <%= currentPage === 'payments' ? 'active' : '' %>"
		>
			<span class="icon"><i class="fa-solid fa-money-bill-wave"></i></span>
			<span class="label">Pembayaran &amp; Termin</span>
		</a>
	</nav>

	<div class="sidebar-footer">
		<a href="/auth/logout" class="logout-btn">
			<span class="icon"><i class="fa-solid fa-arrow-right-from-bracket"></i></span>
			<span class="label">Logout</span>
		</a>
	</div>
</aside>