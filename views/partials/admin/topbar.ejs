<div class="top-bar">
	<div class="top-bar-left">
		<button class="hamburger-menu" id="hamburgerMenu">≡</button>
		<h1><%= pageTitle %></h1>
	</div>
	<% if (showUserInfo) { %>
	<div class="user-info">
		<% 
			let displayName = adminName || admins?.username || 'Admin User';
			let generatedInitial = displayName
				.trim()
				.split(/\s+/)
				.slice(0, 1)
				.map(word => word[0])
				.join("")
				.toUpperCase();
   		%>
		<span><%= displayName %></span>
		<div class="avatar"><%= generatedInitial || 'A' %></div>
	</div>
	<% } %>
</div>