<!DOCTYPE html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Cek Dokumen - Restu Production</title>
		<link rel="stylesheet" href="/css/style.css" />
		<style>
			:root {
				--primary: #0356fc;
				--primary-dark: #0244cc;
				--secondary: #fc032d;
				--bg: #f4f6fb;
				--text: #1a1f36;
				--text-muted: #6b7280;
				--border: #e5e7eb;
			}

			body {
				background: var(--bg);
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
				padding: 1rem;
			}

			.check-invoice-container {
				width: 100%;
				max-width: 480px;
				padding: 2.5rem;
				background: white;
				border-radius: 12px;
				box-shadow: 0 10px 30px rgba(3, 86, 252, 0.08);
				border: 1px solid var(--border);
			}

			.check-invoice-container h1 {
				text-align: center;
				color: var(--text);
				margin-bottom: 0.35rem;
				font-size: 1.6rem;
				font-weight: 700;
			}

			.subtitle {
				text-align: center;
				color: var(--text-muted);
				margin-bottom: 1.75rem;
				font-size: 0.9rem;
				line-height: 1.5;
			}

			.form-group {
				margin-bottom: 1.25rem;
			}

			.form-group label {
				display: block;
				margin-bottom: 0.4rem;
				color: #374151;
				font-weight: 500;
				font-size: 0.85rem;
			}

			.form-group input {
				width: 100%;
				padding: 0.75rem 0.85rem;
				border: 1px solid #d1d5db;
				border-radius: 6px;
				font-size: 0.95rem;
				box-sizing: border-box;
				transition: border-color 0.2s, box-shadow 0.2s;
			}

			.form-group input:focus {
				outline: none;
				border-color: var(--primary);
				box-shadow: 0 0 0 3px rgba(3, 86, 252, 0.1);
			}

			.submit-btn {
				width: 100%;
				padding: 0.8rem;
				background: var(--primary);
				color: white;
				border: none;
				border-radius: 6px;
				font-size: 0.95rem;
				font-weight: 600;
				cursor: pointer;
				transition: background 0.2s;
				margin-top: 0.5rem;
			}

			.submit-btn:hover {
				background: var(--primary-dark);
			}

			.error {
				background-color: #fff0f2;
				color: var(--secondary);
				border: 1px solid #fca5a5;
				padding: 0.75rem;
				border-radius: 6px;
				margin-bottom: 1.25rem;
				text-align: center;
				font-size: 0.88rem;
			}

			.success {
				background-color: #e6f9f0;
				color: #15803d;
				border: 1px solid #86efac;
				padding: 0.75rem;
				border-radius: 6px;
				margin-bottom: 1.25rem;
				text-align: center;
				font-size: 0.88rem;
			}

			.info-box {
				background: #f8f9fb;
				padding: 1rem 1.25rem;
				border-radius: 8px;
				margin-top: 1.75rem;
				border-left: 3px solid var(--primary);
			}

			.info-box p {
				margin: 0.25rem 0;
				font-size: 0.85rem;
				color: var(--text-muted);
			}

			.info-box strong {
				color: var(--text);
			}
		</style>
	</head>
	<body>
		<div class="check-invoice-container">
			<h1>Cek Dokumen</h1>
			<p class="subtitle">
				Masukkan nomor dokumen dan nomor telepon penerima untuk verifikasi dan melihat rincian
			</p>

			<% if (error) { %>
			<div class="error"><%= error %></div>
			<% } %> <% if (success) { %>
			<div class="success"><%= success %></div>
			<% } %>

			<form action="/invoice/check" method="POST">
				<div class="form-group">
					<label for="invoice_number">Nomor Dokumen</label>
					<input
						type="text"
						id="invoice_number"
						name="invoice_number"
						placeholder="Contoh: INV/RESPRO/001/11.2026"
						required
					/>
				</div>

				<div class="form-group">
					<label for="recipient_phone">Nomor Telepon Penerima</label>
					<input
						type="tel"
						id="recipient_phone"
						name="recipient_phone"
						placeholder="Contoh: 08123456789"
						required
					/>
				</div>

				<button type="submit" class="submit-btn">Cari Dokumen</button>
			</form>

			<div class="info-box">
				<p><strong>Informasi:</strong></p>
				<p>
					Nomor dokumen dan nomor telepon harus sesuai dengan data yang terdaftar pada sistem Restu Production.
				</p>
			</div>
		</div>
	</body>
</html>
