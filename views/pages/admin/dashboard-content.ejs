<div class="dashboard-content">
	<!-- Page Header -->
	<div style="margin-bottom: 1.75rem;">
		<h2 style="font-size: 1.4rem; font-weight: 700; color: var(--text); letter-spacing: -0.3px; margin-bottom: 0.25rem;">
			Ringkasan & Statistik
		</h2>
		<p style="color: var(--text-muted); font-size: 0.9rem;">
			Pantau status penerbitan invoice dan penawaran harga
		</p>
	</div>

	<!-- Stats Grid -->
	<div class="stats-grid">
		<div class="stat-card">
			<div class="stat-icon" style="background: var(--primary-light); color: var(--primary); font-size: 1.2rem;">
				📄
			</div>
			<div class="stat-info">
				<p class="stat-label">Total Dokumen</p>
				<p class="stat-value"><%= stats.total_invoices || 0 %></p>
			</div>
		</div>

		<div class="stat-card">
			<div class="stat-icon" style="background: #e6f9f0; color: #15803d; font-size: 1.2rem;">
				✅
			</div>
			<div class="stat-info">
				<p class="stat-label">Sudah Dibayar</p>
				<p class="stat-value" style="color: #15803d;"><%= stats.paid || 0 %></p>
			</div>
		</div>

		<div class="stat-card">
			<div class="stat-icon" style="background: #fff4e5; color: #d97706; font-size: 1.2rem;">
				📤
			</div>
			<div class="stat-info">
				<p class="stat-label">Diterbitkan</p>
				<p class="stat-value" style="color: #d97706;"><%= stats.issued || 0 %></p>
			</div>
		</div>

		<div class="stat-card">
			<div class="stat-icon" style="background: #fff0f2; color: #fc032d; font-size: 1.2rem;">
				⚠️
			</div>
			<div class="stat-info">
				<p class="stat-label">Jatuh Tempo</p>
				<p class="stat-value" style="color: #fc032d;"><%= stats.overdue || 0 %></p>
			</div>
		</div>
	</div>

	<!-- Total Value Card -->
	<div class="value-card" style="background: var(--primary); border-radius: var(--radius); padding: 1.5rem 1.75rem; color: white; display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.75rem; box-shadow: 0 4px 20px rgba(3, 86, 252, 0.18);">
		<div>
			<h3 style="font-size: 0.85rem; font-weight: 500; opacity: 0.85; margin-bottom: 0.35rem; text-transform: uppercase; letter-spacing: 0.5px;">
				Total Akumulasi Nilai
			</h3>
			<p class="value-amount" style="font-size: 2rem; font-weight: 800; letter-spacing: -0.5px; margin: 0;">
				Rp <%= Math.round(stats.total_value || 0).toLocaleString('id-ID') %>
			</p>
		</div>
		<div>
			<a href="/admin/invoice/create" class="btn" style="background: white; color: var(--primary); font-weight: 600; padding: 0.6rem 1.2rem; border-radius: 6px; text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem;">
				+ Buat Dokumen
			</a>
		</div>
	</div>

	<!-- Recent Invoices Table -->
	<div class="recent-section">
		<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
			<h3 style="font-size: 1.05rem; font-weight: 600; color: var(--text); margin: 0;">
				Dokumen Terbaru
			</h3>
			<a href="/admin/invoice/history" style="font-size: 0.85rem; color: var(--primary); text-decoration: none; font-weight: 500;">
				Lihat Semua →
			</a>
		</div>

		<% if (recentInvoices && recentInvoices.length > 0) { %>
		<div class="table-container">
			<table class="invoices-table">
				<thead>
					<tr>
						<th>No. Dokumen</th>
						<th>Tipe</th>
						<th>Penerima</th>
						<th>Perusahaan</th>
						<th>Tanggal</th>
						<th style="text-align: right;">Total</th>
						<th style="text-align: center;">Status</th>
						<th style="text-align: center;">Aksi</th>
					</tr>
				</thead>
				<tbody>
					<% recentInvoices.forEach(invoice => { 
						const isQuotation = invoice.document_type === 'quotation';
					%>
					<tr>
						<td>
							<a href="/admin/invoice/<%= invoice.id %>" style="color: var(--primary); font-weight: 600; text-decoration: none;">
								<%= invoice.invoice_number %>
							</a>
						</td>
						<td>
							<% if (isQuotation) { %>
								<span class="badge" style="background: #fff4e5; color: #d97706; font-size: 0.72rem;">
									📋 Penawaran
								</span>
							<% } else { %>
								<span class="badge" style="background: var(--primary-light); color: var(--primary); font-size: 0.72rem;">
									🧾 Invoice
								</span>
							<% } %>
						</td>
						<td style="font-weight: 500;"><%= invoice.recipient_name %></td>
						<td style="color: var(--text-muted); font-size: 0.85rem;"><%= invoice.company_name %></td>
						<td>
							<%= new Date(invoice.invoice_date).toLocaleDateString('id-ID') %>
						</td>
						<td style="text-align: right; font-weight: 600;">
							Rp <%= Math.round(invoice.total_amount || 0).toLocaleString('id-ID') %>
						</td>
						<td style="text-align: center;">
							<span class="badge status-<%= invoice.status %>">
								<%= invoice.status.toUpperCase() %>
							</span>
						</td>
						<td style="text-align: center;">
							<a href="/admin/invoice/<%= invoice.id %>" class="btn-small">
								Lihat
							</a>
						</td>
					</tr>
					<% }); %>
				</tbody>
			</table>
		</div>
		<% } else { %>
		<div class="empty-state">
			<div style="font-size: 2.5rem; margin-bottom: 0.5rem; opacity: 0.4;">📄</div>
			<p>Belum ada dokumen yang dibuat</p>
			<a href="/admin/invoice/create" class="btn btn-primary" style="display: inline-flex; margin-top: 0.5rem;">
				+ Buat Invoice Baru
			</a>
		</div>
		<% } %>
	</div>
</div>
