<div class="dashboard-content">
	<div style="margin-bottom: 1.75rem;">
		<h2 style="font-size: 1.4rem; font-weight: 700; color: var(--text); letter-spacing: -0.3px; margin-bottom: 0.25rem;">
			Ringkasan & Statistik
		</h2>
		<p style="color: var(--text-muted); font-size: 0.9rem;">
			Pantau status penerbitan invoice dan penawaran harga
		</p>
	</div>

	<div class="stats-grid">
		<div class="stat-card">
			<div class="stat-icon" style="background: var(--primary-light); color: var(--primary); font-size: 1.2rem;">
				<i class="fa-regular fa-file-lines"></i>
			</div>
			<div class="stat-info">
				<p class="stat-label">Total Dokumen</p>
				<p class="stat-value"><%= stats.total_invoices || 0 %></p>
			</div>
		</div>

		<div class="stat-card">
			<div class="stat-icon" style="background: #e6f9f0; color: #15803d; font-size: 1.2rem;">
				<i class="fa-solid fa-check"></i>
			</div>
			<div class="stat-info">
				<p class="stat-label">Sudah Dibayar</p>
				<p class="stat-value" style="color: #15803d;"><%= stats.paid || 0 %></p>
			</div>
		</div>

		<div class="stat-card">
			<div class="stat-icon" style="background: #fff4e5; color: #d97706; font-size: 1.2rem;">
				<i class="fa-solid fa-file-export"></i>
			</div>
			<div class="stat-info">
				<p class="stat-label">Diterbitkan</p>
				<p class="stat-value" style="color: #d97706;"><%= stats.issued || 0 %></p>
			</div>
		</div>

		<div class="stat-card">
			<div class="stat-icon" style="background: #fff0f2; color: #fc032d; font-size: 1.2rem;">
				<i class="fa-regular fa-calendar-xmark"></i>
			</div>
			<div class="stat-info">
				<p class="stat-label">Jatuh Tempo</p>
				<p class="stat-value" style="color: #fc032d;"><%= stats.overdue || 0 %></p>
			</div>
		</div>
	</div>

	<!-- Total Value Card -->
	<%
		const incomeValues = {
			invoice: Math.round(Number(stats.total_value_invoice) || 0),
			quotation: Math.round(Number(stats.total_value_quotation) || 0),
			total: Math.round(Number(stats.total_value) || 0),
		}
		const formatRupiah = (value) => `Rp ${value.toLocaleString('id-ID')}`
	%>
	<div class="value-card" style="background: var(--primary); border-radius: var(--radius); padding: 1.5rem 1.75rem; color: white; display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.75rem; box-shadow: 0 4px 20px rgba(3, 86, 252, 0.18);">
		<div class="income-carousel">
			<div class="income-viewport" id="incomeViewport" tabindex="0" role="group" aria-label="Ringkasan nilai dokumen">
				<div class="income-slide">
					<h3 class="income-label"><i class="fa-solid fa-file-invoice"></i> Income Invoice</h3>
					<p class="value-amount"><%= formatRupiah(incomeValues.invoice) %></p>
				</div>
				<div class="income-slide">
					<h3 class="income-label"><i class="fa-solid fa-file-import"></i> Income Penawaran</h3>
					<p class="value-amount"><%= formatRupiah(incomeValues.quotation) %></p>
				</div>
				<div class="income-slide">
					<h3 class="income-label"><i class="fa-solid fa-sack-dollar"></i> Total</h3>
					<p class="value-amount"><%= formatRupiah(incomeValues.total) %></p>
				</div>
			</div>
			<div class="income-controls">
				<button type="button" class="income-nav" data-income-prev aria-label="Nilai sebelumnya" title="Nilai sebelumnya">
					<i class="fa-solid fa-chevron-up"></i>
				</button>
				<div class="income-dots" aria-label="Pilih ringkasan nilai">
					<button type="button" class="income-dot is-active" data-income-index="0" aria-label="Income invoice" aria-current="true"></button>
					<button type="button" class="income-dot" data-income-index="1" aria-label="Income penawaran"></button>
					<button type="button" class="income-dot" data-income-index="2" aria-label="Total"></button>
				</div>
				<button type="button" class="income-nav" data-income-next aria-label="Nilai berikutnya" title="Nilai berikutnya">
					<i class="fa-solid fa-chevron-down"></i>
				</button>
			</div>
		</div>
		<div>
			<a href="/admin/invoice/create" class="btn" style="background: white; color: var(--primary); font-weight: 600; padding: 0.6rem 1.2rem; border-radius: 6px; text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem;">
				+ Buat Dokumen
			</a>
		</div>
	</div>
	<script src="/js/dashboard-income.js"></script>

	<!-- Recent Invoices Table -->
	<div class="recent-section">
		<div class="recent-header">
			<h3 style="font-size: 1.05rem; font-weight: 600; color: var(--text); margin: 0;">
				Daftar Dokumen
			</h3>
			<div class="recent-header-actions">
				<form method="GET" action="/admin/invoice/dashboard" class="sort-form">
					<label for="sortFilter" class="sort-label">
						<i class="fa-solid fa-arrow-down-wide-short"></i> Urutkan
					</label>
					<select id="sortFilter" name="sort" class="sort-select" onchange="this.form.submit()">
						<%- include('../../partials/admin/sort-options', { sort: typeof sort !== 'undefined' ? sort : 'invoice_date_desc' }) %>
					</select>
				</form>
				<a href="/admin/invoice/history" style="font-size: 0.85rem; color: var(--primary); text-decoration: none; font-weight: 500;">
					Lihat Semua <i class="fa-solid fa-arrow-right"></i>
				</a>
			</div>
		</div>

		<% if (recentInvoices && recentInvoices.length > 0) { %>
		<div class="table-container">
			<table class="invoices-table">
				<thead>
					<tr>
						<th>No. Dokumen</th>
						<th>Tipe</th>
						<th>Penerima</th>
						<th>Perusahaan</th>
						<th>Tanggal</th>
						<th style="text-align: right;">Total</th>
						<th style="text-align: center;">Status</th>
						<th style="text-align: center;">Aksi</th>
					</tr>
				</thead>
				<tbody>
					<% recentInvoices.forEach(invoice => { 
						const isQuotation = invoice.document_type === 'quotation';
					%>
					<tr>
						<td>
							<a href="/admin/invoice/<%= invoice.id %>" style="color: var(--primary); font-weight: 600; text-decoration: none;">
								<%= invoice.invoice_number %>
							</a>
						</td>
						<td>
							<% if (isQuotation) { %>
								<span class="badge" style="background: #fff4e5; color: #ffbf00; font-size: 0.72rem;">
									<i class="fa-solid fa-file-import"></i> Penawaran
								</span>
							<% } else { %>
								<span class="badge" style="background: var(--primary-light); color: var(--primary); font-size: 0.72rem;">
									<i class="fa-solid fa-file-invoice"></i> Invoice
								</span>
							<% } %>
						</td>
						<td style="font-weight: 500;"><%= invoice.recipient_name %></td>
						<td style="color: var(--text-muted); font-size: 0.85rem;"><%= invoice.company_name %></td>
						<td>
							<%= new Date(invoice.invoice_date).toLocaleDateString('id-ID') %>
						</td>
						<td style="text-align: right; font-weight: 600;">
							Rp <%= Math.round(invoice.total_amount || 0).toLocaleString('id-ID') %>
						</td>
						<td style="text-align: center;">
							<span class="badge status-<%= invoice.status %>">
								<%= invoice.status.toUpperCase() %>
							</span>
						</td>
						<td style="text-align: center;">
							<a href="/admin/invoice/<%= invoice.id %>" class="btn-small">
								Lihat
							</a>
						</td>
					</tr>
					<% }); %>
				</tbody>
			</table>
		</div>
		<% } else { %>
		<div class="empty-state">
			<div style="font-size: 2.5rem; margin-bottom: 0.5rem; opacity: 0.4;"><i class="fa-regular fa-file"></i></div>
			<p>Belum ada dokumen yang dibuat</p>
			<a href="/admin/invoice/create" class="btn btn-primary" style="display: inline-flex; margin-top: 0.5rem;">
				+ Buat Invoice Baru
			</a>
		</div>
		<% } %>
	</div>
</div>
