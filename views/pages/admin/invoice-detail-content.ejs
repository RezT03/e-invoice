<% 
const isQuotation = invoice.document_type === 'quotation';
const _totalAmount = Number(invoice.total_amount) || 0;
const _totalPaid = (typeof totalPaid !== 'undefined' ? Number(totalPaid) : 0) || 0;
const _remaining = (typeof remaining !== 'undefined') ? Number(remaining) : (_totalAmount - _totalPaid);
const _payments = (typeof payments !== 'undefined' && payments) ? payments : [];
const _payUrl = '/admin/payments/create?invoice_id=' + encodeURIComponent(invoice.id) + '&redirect_to=' + encodeURIComponent('/admin/invoice/' + invoice.id);
%>
<div class="detail-container-main">
	<!-- Header dengan nomor invoice dan aksi -->
	<div class="detail-header">
		<div>
			<div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.35rem; flex-wrap: wrap;">
				<span class="invoice-number-display"><%= invoice.invoice_number %></span>
				<% if (isQuotation) { %>
					<span class="badge" style="background: #fff4e5; color: #d97706; font-size: 0.8rem; padding: 0.3rem 0.75rem;">
						<i class="fa-solid fa-clipboard-list"></i> PENAWARAN HARGA
					</span>
				<% } else { %>
					<span class="badge" style="background: var(--primary-light); color: var(--primary); font-size: 0.8rem; padding: 0.3rem 0.75rem;">
						<i class="fa-solid fa-receipt"></i> INVOICE
					</span>
				<% } %>
			</div>
			<span class="invoice-status status-<%= invoice.status %>">
				<%= invoice.status.toUpperCase() %>
			</span>
		</div>
		<div class="action-buttons">
			<% if (isQuotation) { %>
				<button class="btn btn-convert" onclick="convertToInvoice()">
					<i class="fa-solid fa-arrow-right-arrow-left"></i> Konversi ke Invoice
				</button>
			<% } else { %>
				<a href="<%= _payUrl %>" class="btn btn-primary">
					<i class="fa-solid fa-money-bill-wave"></i> Catat Pembayaran
				</a>
			<% } %>
			<button class="btn btn-warning" onclick="openEditM()">
				Edit <%= isQuotation ? 'Penawaran' : 'Invoice' %>
			</button>
			<a
				href="/admin/invoice/<%= invoice.id %>/pdf/normal"
				class="btn btn-primary"
				download
			>
				Download PDF
			</a>
			<button class="btn btn-success" onclick="generateShareLink()">
				Share Link
			</button>
			<a href="/admin/invoice/history<%= isQuotation ? '?document_type=quotation' : '?document_type=invoice' %>" class="btn btn-secondary">
				Kembali
			</a>
			<button class="btn btn-danger" onclick="deleteInvoice()">
				Hapus
			</button>
		</div>
	</div>

	<div class="detail-container">
		<!-- Main Content -->
		<div>
			<!-- Informasi Dasar -->
			<div class="detail-card">
				<h3><%= isQuotation ? 'Informasi Penawaran' : 'Informasi Invoice' %></h3>
				<div class="detail-row">
					<div class="detail-label">Nomor Dokumen:</div>
					<div class="detail-value" style="font-weight: 600;"><%= invoice.invoice_number %></div>
				</div>
				<div class="detail-row">
					<div class="detail-label">Tanggal:</div>
					<div class="detail-value">
						<%= new Date(invoice.invoice_date).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }) %>
					</div>
				</div>
				<% if (invoice.due_date) { %>
				<div class="detail-row">
					<div class="detail-label"><%= isQuotation ? 'Berlaku Hingga:' : 'Jatuh Tempo:' %></div>
					<div class="detail-value">
						<%= new Date(invoice.due_date).toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' }) %>
					</div>
				</div>
				<% } %>
				<div class="detail-row">
					<div class="detail-label">Perusahaan:</div>
					<div class="detail-value"><%= invoice.company_name %></div>
				</div>
			</div>

			<!-- Data Penerima -->
			<div class="detail-card">
				<h3>Data Penerima</h3>
				<div class="detail-row">
					<div class="detail-label">Nama:</div>
					<div class="detail-value" style="font-weight: 600;"><%= invoice.recipient_name %></div>
				</div>
				<% if (invoice.recipient_phone) { %>
				<div class="detail-row">
					<div class="detail-label">Telepon:</div>
					<div class="detail-value"><%= invoice.recipient_phone %></div>
				</div>
				<% } %>
				<% if (invoice.recipient_npwp) { %>
				<div class="detail-row">
					<div class="detail-label">NPWP:</div>
					<div class="detail-value"><%= invoice.recipient_npwp %></div>
				</div>
				<% } %>
				<% if (invoice.recipient_address) { %>
				<div class="detail-row">
					<div class="detail-label">Alamat:</div>
					<div class="detail-value"><%= invoice.recipient_address %></div>
				</div>
				<% } %>
			</div>

			<!-- Daftar Item -->
			<div class="detail-card">
				<h3>Daftar Barang / Jasa</h3>
				<% if (invoice.items && invoice.items.length > 0) { %>
				<div class="table-container">
				<table class="items-table">
					<thead>
						<tr>
							<th style="width: 40px; text-align: center;">No</th>
							<th>Deskripsi</th>
							<th style="text-align: center;">Qty</th>
							<th style="text-align: center;">Satuan</th>
							<th style="text-align: right;">Harga Satuan</th>
							<th style="text-align: right;">Total</th>
						</tr>
					</thead>
					<tbody>
						<% 
						let globalIdx = 0;
						let calculatedSubtotal = 0;

						invoice.items.forEach(item => {
							if (item.is_group) {
								let groupSubtotal = 0;
						%>
							<!-- Group Header Row -->
							<tr class="group-row">
								<td colspan="6" style="background: var(--primary); color: white; font-weight: 700; padding: 0.5rem 0.75rem;">
									<%= item.group_name || 'Grup' %>
								</td>
							</tr>
							<% (item.items || []).forEach(sub => { 
								globalIdx++;
								const lineTotal = (sub.quantity || 0) * (sub.price || 0);
								groupSubtotal += lineTotal;
								calculatedSubtotal += lineTotal;
							%>
							<tr>
								<td style="text-align: center; color: var(--text-muted);"><%= globalIdx %></td>
								<td><%= sub.description || sub.name %></td>
								<td style="text-align: center;"><%= sub.quantity %></td>
								<td style="text-align: center;"><%= sub.unit || '-' %></td>
								<td style="text-align: right;">
									Rp <%= Math.round(sub.price || 0).toLocaleString('id-ID') %>
								</td>
								<td style="text-align: right; font-weight: 500;">
									Rp <%= Math.round(lineTotal).toLocaleString('id-ID') %>
								</td>
							</tr>
							<% }); %>
							<!-- Group Subtotal Row -->
							<tr class="subtotal-row">
								<td colspan="5" style="text-align: right; font-weight: 600; color: var(--primary); background: var(--primary-light);">
									Subtotal <%= item.group_name %>:
								</td>
								<td style="text-align: right; font-weight: 700; color: var(--primary); background: var(--primary-light);">
									Rp <%= Math.round(groupSubtotal).toLocaleString('id-ID') %>
								</td>
							</tr>
						<% 
							} else {
								globalIdx++;
								const lineTotal = (item.quantity || 0) * (item.price || 0);
								calculatedSubtotal += lineTotal;
						%>
							<tr>
								<td style="text-align: center; color: var(--text-muted);"><%= globalIdx %></td>
								<td><%= item.description || item.name %></td>
								<td style="text-align: center;"><%= item.quantity %></td>
								<td style="text-align: center;"><%= item.unit || '-' %></td>
								<td style="text-align: right;">
									Rp <%= Math.round(item.price || 0).toLocaleString('id-ID') %>
								</td>
								<td style="text-align: right; font-weight: 500;">
									Rp <%= Math.round(lineTotal).toLocaleString('id-ID') %>
								</td>
							</tr>
						<% 
							}
						}); 
						%>

						<!-- Subtotal Summary -->
						<tr class="total-row">
							<td colspan="5" style="text-align: right; font-weight: 600;">Subtotal:</td>
							<td style="text-align: right; font-weight: 600;">
								Rp <%= Math.round(calculatedSubtotal).toLocaleString('id-ID') %>
							</td>
						</tr>

						<!-- Diskon jika ada -->
						<% if (invoice.discount_value > 0) { %>
						<tr>
							<td colspan="5" style="text-align: right; color: #15803d;">
								Diskon (<%= invoice.discount_type === 'percentage' ? invoice.discount_value + '%' : 'Nominal' %>):
							</td>
							<td style="text-align: right; color: #15803d; font-weight: 600;">
								− Rp <%= Math.round(invoice.discount_value || 0).toLocaleString('id-ID') %>
							</td>
						</tr>
						<% } %>

						<!-- Pajak jika ada -->
						<% (invoice.taxes || []).forEach(tax => { %>
						<tr>
							<td colspan="5" style="text-align: right; color: var(--text-muted);">
								<%= tax.name %> (<%= tax.percentage %>%):
							</td>
							<td style="text-align: right;">
								Rp <%= Math.round(tax.amount || 0).toLocaleString('id-ID') %>
							</td>
						</tr>
						<% }); %>

						<!-- Grand Total -->
						<tr style="border-top: 2px solid var(--primary); background: var(--bg);">
							<td colspan="5" style="text-align: right; font-weight: 700; font-size: 1rem; color: var(--text);">
								Total Akhir:
							</td>
							<td style="text-align: right; font-weight: 700; font-size: 1.15rem; color: var(--primary);">
								Rp <%= Math.round(invoice.total_amount || 0).toLocaleString('id-ID') %>
							</td>
						</tr>
					</tbody>
				</table>
				</div>
				<% } else { %>
				<p style="color: var(--text-muted);">Tidak ada item</p>
				<% } %>
			</div>

			<!-- Info Pembayaran: semua rekening dalam 1 nama company -->
			<% if (!isQuotation) { %>
			<div class="detail-card">
				<h3>Informasi Pembayaran (Transfer Bank)</h3>
				<div class="detail-row">
					<div class="detail-label">Perusahaan:</div>
					<div class="detail-value" style="font-weight: 600;"><%= invoice.company_name %></div>
				</div>
				<% if (bankAccounts && bankAccounts.length) { %>
					<% bankAccounts.forEach((account, index) => { %>
					<div style="border-top: 1px solid #eef0f3; padding-top: 0.6rem; margin-top: 0.6rem;">
						<div class="detail-row">
							<div class="detail-label">Bank <%= index + 1 %>:</div>
							<div class="detail-value">
								<%= account.bank_name %>
								<% if (account.is_default) { %>
								<span class="badge" style="background: var(--primary-light); color: var(--primary); font-size: 0.65rem; margin-left: 0.35rem;">Utama</span>
								<% } %>
							</div>
						</div>
						<div class="detail-row">
							<div class="detail-label">No. Rekening:</div>
							<div class="detail-value" style="font-weight: 700; color: var(--primary); font-size: 1.05rem;">
								<%= account.account_number %>
							</div>
						</div>
						<div class="detail-row">
							<div class="detail-label">Atas Nama:</div>
							<div class="detail-value"><%= account.account_name %></div>
						</div>
					</div>
					<% }) %>
				<% } else { %>
				<p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 0.5rem;">
					Belum ada rekening terdaftar. Tambahkan di panel "Rekening & Opsi PDF".
				</p>
				<% } %>
			</div>
			<% } %>
		</div>

		<!-- Sidebar -->
		<div>
			<!-- Total Ringkasan -->
			<div class="detail-card">
				<h3>Total Nilai</h3>
				<div style="font-size: clamp(1.15rem, 4vw, 1.6rem); color: var(--primary); font-weight: 800; letter-spacing: -0.5px; overflow-wrap: anywhere;">
					Rp <%= Math.round(invoice.total_amount || 0).toLocaleString('id-ID') %>
				</div>
				<div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.25rem;">
					<%= isQuotation ? 'Total Penawaran Harga' : 'Total Tagihan Invoice' %>
				</div>
			</div>

			<!-- Pembayaran & Termin (hanya untuk Invoice) -->
			<% if (!isQuotation) { %>
			<div class="detail-card">
				<h3>Pembayaran &amp; Termin</h3>

				<div class="payment-progress">
					<div class="payment-progress-row">
						<span>Total Tagihan</span>
						<strong>Rp <%= Math.round(_totalAmount).toLocaleString('id-ID') %></strong>
					</div>
					<div class="payment-progress-row paid">
						<span>Sudah Dibayar</span>
						<strong>Rp <%= Math.round(_totalPaid).toLocaleString('id-ID') %></strong>
					</div>
					<div class="payment-progress-row remaining">
						<span>Sisa Tagihan</span>
						<strong>Rp <%= Math.round(_remaining).toLocaleString('id-ID') %></strong>
					</div>
					<% if (_totalAmount > 0) { %>
					<div class="payment-progress-bar">
						<div
							class="payment-progress-fill"
							style="width: <%= Math.min(100, Math.max(0, Math.round((_totalPaid / _totalAmount) * 100))) %>%;"
						></div>
					</div>
					<% } %>
				</div>

				<% if (_payments.length) { %>
				<ul class="payment-mini-list">
					<% _payments.forEach(p => { %>
					<li>
						<div class="pml-main">
							<div class="pml-number"><%= p.payment_number %></div>
							<div class="pml-meta">
								<%= new Date(p.payment_date).toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' }) %>
								&middot; Rp <%= Math.round(Number(p.amount) || 0).toLocaleString('id-ID') %>
							</div>
						</div>
						<div class="pml-actions">
							<% if (p.proof_path) { %>
							<a
								href="/admin/payments/<%= p.id %>/proof"
								target="_blank"
								rel="noopener"
								class="btn-small secondary"
								title="Lihat bukti bayar"
							><i class="fa-solid fa-image"></i></a>
							<% } %>
							<a href="/admin/payments/<%= p.id %>/edit" class="btn-small" title="Edit pembayaran">Edit</a>
						</div>
					</li>
					<% }); %>
				</ul>
				<% } else { %>
				<p class="payment-empty">Belum ada pembayaran dicatat.</p>
				<% } %>

				<a
					href="<%= _payUrl %>"
					class="btn btn-primary"
					style="width: 100%; justify-content: center; margin-top: 0.6rem;"
				>
					<i class="fa-solid fa-plus"></i> Catat Pembayaran
				</a>
			</div>
			<% } %>

			<!-- Update Status -->
			<div class="detail-card">
				<h3>Status Dokumen</h3>
				<div class="status-update">
					<select id="statusSelect">
						<% if (isQuotation) { %>
							<option value="draft" <%= invoice.status === 'draft' ? 'selected' : '' %>>Draft</option>
							<option value="sent" <%= invoice.status === 'sent' ? 'selected' : '' %>>Terkirim</option>
							<option value="accepted" <%= invoice.status === 'accepted' ? 'selected' : '' %>>Diterima</option>
							<option value="rejected" <%= invoice.status === 'rejected' ? 'selected' : '' %>>Ditolak</option>
							<option value="cancelled" <%= invoice.status === 'cancelled' ? 'selected' : '' %>>Dibatalkan</option>
						<% } else { %>
							<option value="draft" <%= invoice.status === 'draft' ? 'selected' : '' %>>Draft</option>
							<option value="issued" <%= invoice.status === 'issued' ? 'selected' : '' %>>Diterbitkan</option>
							<option value="sent" <%= invoice.status === 'sent' ? 'selected' : '' %>>Terkirim</option>
							<option value="paid" <%= invoice.status === 'paid' ? 'selected' : '' %>>Dibayar (Lunas)</option>
							<option value="overdue" <%= invoice.status === 'overdue' ? 'selected' : '' %>>Jatuh Tempo</option>
							<option value="cancelled" <%= invoice.status === 'cancelled' ? 'selected' : '' %>>Dibatalkan</option>
						<% } %>
					</select>
					<% if (!isQuotation) { %>
					<div id="paidDateWrapper" <%= invoice.status === 'paid' ? '' : 'hidden' %>>
						<label style="font-size: 0.78rem; color: var(--text-muted); margin-bottom: 0.25rem; display: block;">Tanggal Lunas:</label>
						<input
							type="date"
							id="paidDate"
							value="<%= invoice.paid_date ? new Date(invoice.paid_date).toISOString().split('T')[0] : '' %>"
						/>
					</div>
					<% } %>
					<button
						class="btn btn-primary"
						onclick="updateStatus()"
						style="margin-top: 0.25rem;"
					>
						Simpan Status
					</button>
				</div>
			</div>

			<!-- Share Link -->
			<div class="detail-card">
				<h3>Public Share Link</h3>
				<div id="shareLinkContainer" style="display: none">
					<div class="share-link-box">
						<input type="text" id="shareLink" readonly />
						<button class="copy-btn" onclick="copyShareLink()">
							Copy
						</button>
					</div>
				</div>
				<div id="noShareLinkMsg" style="color: var(--text-muted); font-size: 0.85rem;">
					<p>Belum ada link berbagi.</p>
					<button class="btn btn-small" onclick="generateShareLink()" style="margin-top: 0.5rem;">
						Buat Share Link
					</button>
				</div>
				<% if (!isQuotation) { %>
				<div style="border-top: 1px solid #eef0f3; margin-top: 0.75rem; padding-top: 0.75rem;">
					<div style="font-size: 0.78rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.4px; margin-bottom: 0.35rem;">
						Rekening <%= invoice.company_name %>
					</div>
					<% if (bankAccounts && bankAccounts.length) { %>
						<% bankAccounts.forEach((account) => { %>
						<div style="font-size: 0.82rem; line-height: 1.5;">
							<strong><%= account.bank_name %></strong> &middot; <%= account.account_number %> &middot; <%= account.account_name %>
						</div>
						<% }) %>
					<% } else { %>
					<div style="font-size: 0.82rem; color: var(--text-muted);">Belum ada rekening.</div>
					<% } %>
				</div>
				<% } %>
			</div>

			<% if (!isQuotation) { %>
			<div class="detail-card" id="pdfOptionsCard">
				<h3>Rekening & Opsi PDF Normal</h3>
				<p style="color: var(--text-muted); font-size: 0.8rem; margin: 0.25rem 0 0.75rem;">
					Pengaturan ini hanya memengaruhi PDF Standar (Normal). Format Dot Matrix tetap seperti semula.
				</p>

				<div style="border-top: 1px solid #eef0f3; padding-top: 0.75rem;">
					<div class="detail-row">
						<div class="detail-label" style="flex: 1;">Tampilkan rekening di PDF</div>
						<input type="checkbox" id="pdfShowBank" <%= Number(invoice.pdf_show_bank) === 1 ? 'checked' : '' %> />
					</div>
					<div id="pdfAccountOptions" style="padding: 0.25rem 0 0.5rem;">
						<% bankAccounts.forEach((account) => { %>
						<label style="display: flex; gap: 0.5rem; align-items: flex-start; margin: 0.4rem 0; font-size: 0.85rem;">
							<input
								type="checkbox"
								class="pdf-account-checkbox"
								value="<%= account.id %>"
								<%= selectedAccountIds.includes(Number(account.id)) ? 'checked' : '' %>
							/>
							<span>
								<strong><%= account.bank_name %></strong><br />
								<span style="color: var(--text-muted);"><%= account.account_number %> &middot; <%= account.account_name %></span>
							</span>
						</label>
						<% }) %>
					</div>
					<div class="detail-row">
						<div class="detail-label" style="flex: 1;">Tampilkan keterangan LUNAS</div>
						<input type="checkbox" id="pdfShowPaidNotice" <%= Number(invoice.pdf_show_paid_notice) === 1 ? 'checked' : '' %> />
					</div>
					<div style="display: flex; align-items: center; gap: 0.6rem; margin-top: 0.75rem;">
						<button type="button" class="btn btn-small" id="savePdfOptions">Simpan Opsi PDF</button>
						<span id="pdfOptionsStatus" style="font-size: 0.8rem; color: var(--text-muted);"></span>
					</div>
				</div>

				<div style="border-top: 1px solid #eef0f3; margin-top: 1rem; padding-top: 0.85rem;">
					<h4 style="font-size: 0.9rem; margin: 0 0 0.5rem;">Kelola Rekening Perusahaan</h4>
					<p style="color: var(--text-muted); font-size: 0.78rem; margin: 0 0 0.6rem;">
						Berlaku untuk semua invoice dari <strong><%= invoice.company_name %></strong>.
					</p>
					<div id="bankAccountList" style="margin-bottom: 0.75rem;"></div>
					<form id="bankAccountForm" style="display: grid; gap: 0.5rem;">
						<input type="hidden" id="bankAccountId" />
						<input type="text" id="bankName" placeholder="Nama bank" maxlength="100" />
						<input type="text" id="bankAccountNumber" placeholder="Nomor rekening" maxlength="50" />
						<input type="text" id="bankAccountName" placeholder="Atas nama" maxlength="255" />
						<label style="font-size: 0.82rem; display: flex; gap: 0.4rem; align-items: center;">
							<input type="checkbox" id="bankAccountDefault" /> Jadikan rekening utama
						</label>
						<div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
							<button type="submit" class="btn btn-small" id="saveBankAccount">Tambah Rekening</button>
							<button type="button" class="btn btn-small secondary" id="cancelBankAccountEdit" style="display: none;">Batal</button>
						</div>
					</form>
					<div id="bankAccountStatus" style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.5rem;"></div>
				</div>
			</div>
			<% } %>

			<!-- Template Info -->
			<% if (invoice.template_name) { %>
			<div class="detail-card">
				<h3>Template Dokumen</h3>
				<div class="detail-row">
					<div class="detail-label">Template:</div>
					<div class="detail-value"><%= invoice.template_name %></div>
				</div>
				<% if (invoice.logo_path) { %>
				<img
					src="<%= invoice.logo_path %>"
					alt="Logo"
					style="max-width: 100%; height: auto; margin-top: 0.75rem; border-radius: 4px;"
				/>
				<% } %>
			</div>
			<% } %>
		</div>
	</div>
</div>

