<%
	const isEdit = product && product.id;
	const formAction = isEdit ? `/admin/products/${product.id}/update` : '/admin/products/create';
	const val = (key, fallback = '') => isEdit && product[key] !== null && product[key] !== undefined ? product[key] : fallback;
%>
<div class="create-container">
	<div class="form-container">
		<div style="margin-bottom: 1.5rem;">
			<h2 style="font-size: 1.25rem; font-weight: 700; color: var(--text); margin-bottom: 0.2rem;">
				<%= isEdit ? 'Edit Produk' : 'Tambah Produk Baru' %>
			</h2>
			<p style="color: var(--text-muted); font-size: 0.85rem;">
				Data produk dipakai sebagai katalog barang sewa pada penawaran/invoice.
			</p>
		</div>

		<% if (typeof error !== 'undefined' && error) { %>
		<div class="booking-alert booking-alert-error">
			<i class="fa-solid fa-circle-exclamation"></i> <%= error %>
		</div>
		<% } %>

		<form action="<%= formAction %>" method="POST">
			<!-- Identitas Produk -->
			<div class="form-section">
				<div class="section-title">
					<div class="section-icon"><i class="fa-solid fa-box"></i></div>
					<h3>Identitas Produk</h3>
				</div>
				<div class="form-row">
					<div class="form-group">
						<label for="sku">SKU / Kode <span class="required">*</span></label>
						<input
							type="text"
							id="sku"
							name="sku"
							placeholder="mis. TND-001"
							required
							value="<%= val('sku') %>"
						/>
					</div>
					<div class="form-group">
						<label for="category">Kategori</label>
						<input
							type="text"
							id="category"
							name="category"
							list="categoryOptions"
							placeholder="mis. Tenda & Panggung"
							value="<%= val('category') %>"
						/>
						<datalist id="categoryOptions">
							<% (categories || []).forEach(cat => { %>
							<option value="<%= cat %>"></option>
							<% }); %>
						</datalist>
					</div>
				</div>
				<div class="form-row full">
					<div class="form-group">
						<label for="name">Nama Produk <span class="required">*</span></label>
						<input
							type="text"
							id="name"
							name="name"
							placeholder="mis. Tenda Roder 5x10"
							required
							value="<%= val('name') %>"
						/>
					</div>
				</div>
				<div class="form-row">
					<div class="form-group">
						<label for="unit">Satuan</label>
						<input
							type="text"
							id="unit"
							name="unit"
							placeholder="unit / pcs / set / m2"
							value="<%= val('unit', 'unit') %>"
						/>
					</div>
					<div class="form-group">
						<label for="is_active">Status</label>
						<select id="is_active" name="is_active">
							<% const active = isEdit ? !!product.is_active : true; %>
							<option value="1" <%= active ? 'selected' : '' %>>Aktif</option>
							<option value="0" <%= !active ? 'selected' : '' %>>Nonaktif</option>
						</select>
					</div>
				</div>
			</div>

			<!-- Harga & Stok -->
			<div class="form-section">
				<div class="section-title">
					<div class="section-icon"><i class="fa-solid fa-tags"></i></div>
					<h3>Harga &amp; Stok</h3>
				</div>
				<div class="form-row">
					<div class="form-group">
						<label for="rental_price">Harga Sewa</label>
						<input
							type="number"
							id="rental_price"
							name="rental_price"
							min="0"
							step="0.01"
							placeholder="0"
							value="<%= val('rental_price', 0) %>"
						/>
					</div>
					<div class="form-group">
						<label for="purchase_price">Harga Beli</label>
						<input
							type="number"
							id="purchase_price"
							name="purchase_price"
							min="0"
							step="0.01"
							placeholder="0"
							value="<%= val('purchase_price', 0) %>"
						/>
					</div>
				</div>
				<div class="form-row">
					<div class="form-group">
						<label for="stock_total">Total Stok</label>
						<input
							type="number"
							id="stock_total"
							name="stock_total"
							min="0"
							step="1"
							placeholder="0"
							value="<%= val('stock_total', 0) %>"
						/>
					</div>
					<div class="form-group">
						<label for="stock_available">Stok Tersedia</label>
						<input
							type="number"
							id="stock_available"
							name="stock_available"
							min="0"
							step="1"
							placeholder="0"
							value="<%= val('stock_available', 0) %>"
						/>
						<p class="field-hint">Jumlah yang siap disewa saat ini.</p>
					</div>
				</div>
			</div>

			<!-- Catatan -->
			<div class="form-section">
				<div class="section-title">
					<div class="section-icon"><i class="fa-regular fa-note-sticky"></i></div>
					<h3>Catatan <span style="font-weight:400; color: var(--text-muted); font-size:0.85rem;">(opsional)</span></h3>
				</div>
				<div class="form-row full">
					<div class="form-group">
						<textarea
							id="notes"
							name="notes"
							placeholder="Spesifikasi, kelengkapan, kondisi, dsb."
						><%= val('notes') %></textarea>
					</div>
				</div>
			</div>

			<!-- Actions -->
			<div class="form-actions">
				<button type="submit" class="btn-submit">
					<i class="fa-solid fa-floppy-disk"></i> <%= isEdit ? 'Simpan Perubahan' : 'Simpan Produk' %>
				</button>
				<a href="/admin/products" class="btn-cancel">Batal</a>
			</div>
		</form>
	</div>
</div>
