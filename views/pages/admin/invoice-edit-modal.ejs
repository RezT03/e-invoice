<!-- Modal untuk Edit Invoice -->
<div id="editInvoiceModal" class="modal">
	<div class="modal-content" style="max-width: 900px">
		<div class="modal-header">
			<h2>Edit Invoice</h2>
			<span class="close" onclick="closeEditModal()">&times;</span>
		</div>
		<div class="modal-body">
			<form id="editInvoiceForm">
				<!-- Nomor & Tgl -->
				<div class="form-section">
					<h3>Informasi Invoice</h3>
					<div class="form-group">
						<label for="invoice_no">No. Invoice*</label>
						<input type="text" name="invoice_number" id="invoice_no" required />
					</div>
					<div class="form-group">
						<label for="inv_date">Tanggal</label>
						<input type="date" name="invoice_date" id="inv_date" />
					</div>
				</div>
				<!-- Informasi Penerima -->
				<div class="form-section">
					<h3>Informasi Penerima</h3>
					<div class="form-group">
						<label for="edit_recipient_name">Nama Penerima *</label>
						<input
							type="text"
							id="edit_recipient_name"
							name="recipient_name"
							required
						/>
					</div>
					<div class="form-group">
						<label for="edit_recipient_phone">Telepon *</label>
						<input
							type="text"
							id="edit_recipient_phone"
							name="recipient_phone"
							required
						/>
					</div>
					<div class="form-group">
						<label for="edit_recipient_npwp">NPWP</label>
						<input type="text" id="edit_recipient_npwp" name="recipient_npwp" />
					</div>
					<div class="form-group">
						<label for="edit_recipient_address">Alamat</label>
						<textarea
							id="edit_recipient_address"
							name="recipient_address"
							rows="3"
						></textarea>
					</div>
				</div>

				<!-- Daftar Item -->
				<div class="form-section">
					<h3>Daftar Item</h3>
					<div id="itemsListEdit"></div>
					<button
						type="button"
						class="btn btn-secondary"
						onclick="addEditItem()"
					>
						+ Tambah Item
					</button>
				</div>

				<!-- Pajak -->
				<div class="form-section">
					<h3>Pajak & Biaya</h3>
					<div id="taxesListEdit"></div>
					<button
						type="button"
						class="btn btn-secondary"
						onclick="addEditTax()"
					>
						+ Tambah Pajak
					</button>
				</div>

				<!-- Diskon -->
				<div class="form-section">
					<h3>Diskon (Opsional)</h3>
					<div class="discount-section">
						<div class="discount-row">
							<div class="form-group">
								<label for="edit_discount_type">Tipe Diskon:</label>
								<select
									id="edit_discount_type"
									name="discount_type"
									onchange="updateEditDiscountLabel()"
								>
									<option value="none">Tanpa Diskon</option>
									<option value="percentage">Persentase (%)</option>
									<option value="nominal">Nominal (Rp)</option>
								</select>
							</div>
							<div class="form-group">
								<label id="edit_discountLabel" for="edit_discount_value">
									Diskon (%):
								</label>
								<input
									type="number"
									id="edit_discount_value"
									name="discount_value"
									placeholder="Misal: 10 untuk 10%"
									value="0"
									min="0"
									step="0.01"
									oninput="updateEditDiscountValue()"
								/>
							</div>
						</div>
					</div>
				</div>

				<!-- Total -->
				<div class="form-section">
					<div class="total-display">
						<h3>
							Total: Rp
							<span id="editTotalAmount">0</span>
						</h3>
					</div>
				</div>
				<div class="modal-actions">
					<button
						type="button"
						class="btn btn-secondary"
						onclick="closeEditModal()"
					>
						Batal
					</button>
					<button type="submit" class="btn btn-primary">
						Simpan Perubahan
					</button>
				</div>
			</form>
		</div>
	</div>
</div>

<style>
