		border: 1px solid #e5e7eb;
	}

	.modal-body .form-section h3 {
		margin-top: 0;
		margin-bottom: 0.85rem;
		color: #1a1f36;
		font-size: 0.95rem;
		font-weight: 600;
	}

	.modal-body .form-group {
		margin-bottom: 0.85rem;
	}

	.modal-body .form-group label {
		display: block;
