		font-family: inherit;
		box-sizing: border-box;
		background: white;
	}

	.modal-body .form-group input:focus,
	.modal-body .form-group textarea:focus,
	.modal-body .form-group select:focus {
		outline: none;
		border-color: #0356fc;
		box-shadow: 0 0 0 3px rgba(3, 86, 252, 0.08);
	}

	.item-row,
	.tax-row {
		display: grid;
		grid-template-columns: 2fr 1fr 0.75fr 1.25fr 1fr auto;
