		border: 1px solid #c7d7fe;
	}

	.discount-section {
		padding: 0;
	}

	.discount-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.modal-actions {
		display: flex;
		justify-content: flex-end;
		gap: 0.75rem;
		margin-top: 1.25rem;
		flex-wrap: wrap;
	}

	@media (max-width: 768px) {
		.modal-content {
			width: calc(100% - 1rem);
