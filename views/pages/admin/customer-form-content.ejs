<%
	const isEdit = customer && customer.id;
	const formAction = isEdit ? `/admin/customers/${customer.id}/update` : '/admin/customers/create';
	const val = (key, fallback = '') => isEdit && customer[key] !== null && customer[key] !== undefined ? customer[key] : fallback;
%>
<div class="create-container">
	<div class="form-container">
		<div style="margin-bottom: 1.5rem;">
			<h2 style="font-size: 1.25rem; font-weight: 700; color: var(--text); margin-bottom: 0.2rem;">
				<%= isEdit ? 'Edit Pelanggan' : 'Tambah Pelanggan Baru' %>
			</h2>
			<p style="color: var(--text-muted); font-size: 0.85rem;">
				Data pelanggan dipakai sebagai sumber klien pada booking dan invoice.
			</p>
		</div>

		<% if (typeof error !== 'undefined' && error) { %>
		<div class="booking-alert booking-alert-error">
			<i class="fa-solid fa-circle-exclamation"></i> <%= error %>
		</div>
		<% } %>

		<form action="<%= formAction %>" method="POST">
			<!-- Identitas Pelanggan -->
			<div class="form-section">
				<div class="section-title">
					<div class="section-icon"><i class="fa-regular fa-user"></i></div>
					<h3>Identitas Pelanggan</h3>
				</div>
				<div class="form-row">
					<div class="form-group">
						<label for="name">Nama <span class="required">*</span></label>
						<input
							type="text"
							id="name"
							name="name"
							placeholder="Nama penanggung jawab / klien"
							required
							value="<%= val('name') %>"
						/>
					</div>
					<div class="form-group">
						<label for="company">Instansi / Perusahaan</label>
						<input
							type="text"
							id="company"
							name="company"
							placeholder="mis. PT Maju Jaya"
							value="<%= val('company') %>"
						/>
					</div>
				</div>
				<div class="form-row">
					<div class="form-group">
						<label for="phone">Nomor Telepon</label>
						<input
							type="text"
							id="phone"
							name="phone"
							placeholder="08123456789"
							value="<%= val('phone') %>"
						/>
					</div>
					<div class="form-group">
						<label for="email">Email</label>
						<input
							type="email"
							id="email"
							name="email"
							placeholder="klien@email.com"
							value="<%= val('email') %>"
						/>
					</div>
				</div>
			</div>

			<!-- Alamat & Pajak -->
			<div class="form-section">
				<div class="section-title">
					<div class="section-icon"><i class="fa-solid fa-location-dot"></i></div>
					<h3>Alamat &amp; Pajak</h3>
				</div>
				<div class="form-row full">
					<div class="form-group">
						<label for="address">Alamat</label>
						<textarea
							id="address"
							name="address"
							placeholder="Alamat lengkap pelanggan"
						><%= val('address') %></textarea>
					</div>
				</div>
				<div class="form-row">
					<div class="form-group">
						<label for="city">Kota</label>
						<input
							type="text"
							id="city"
							name="city"
							placeholder="mis. Bandung"
							value="<%= val('city') %>"
						/>
					</div>
					<div class="form-group">
						<label for="npwp">NPWP</label>
						<input
							type="text"
							id="npwp"
							name="npwp"
							placeholder="00.000.000.0-000.000"
							value="<%= val('npwp') %>"
						/>
					</div>
				</div>
			</div>

			<!-- Catatan -->
			<div class="form-section">
				<div class="section-title">
					<div class="section-icon"><i class="fa-regular fa-note-sticky"></i></div>
					<h3>Catatan <span style="font-weight:400; color: var(--text-muted); font-size:0.85rem;">(opsional)</span></h3>
				</div>
				<div class="form-row full">
					<div class="form-group">
						<label for="is_active">Status</label>
						<select id="is_active" name="is_active">
							<% const active = isEdit ? !!customer.is_active : true; %>
							<option value="1" <%= active ? 'selected' : '' %>>Aktif</option>
							<option value="0" <%= !active ? 'selected' : '' %>>Nonaktif</option>
						</select>
					</div>
				</div>
				<div class="form-row full">
					<div class="form-group">
						<textarea
							id="notes"
							name="notes"
							placeholder="Catatan tambahan tentang pelanggan"
						><%= val('notes') %></textarea>
					</div>
				</div>
			</div>

			<!-- Actions -->
			<div class="form-actions">
				<button type="submit" class="btn-submit">
					<i class="fa-solid fa-floppy-disk"></i> <%= isEdit ? 'Simpan Perubahan' : 'Simpan Pelanggan' %>
				</button>
				<a href="/admin/customers" class="btn-cancel">Batal</a>
			</div>
		</form>
	</div>
</div>
