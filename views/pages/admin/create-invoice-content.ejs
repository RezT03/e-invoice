<div class="create-container">
	<div class="form-container">
		<form id="createInvoiceForm" action="/admin/invoice/create" method="POST">

			<!-- Toggle Jenis Dokumen -->
			<div class="form-section" style="padding-bottom: 1.25rem; margin-bottom: 1.25rem;">
				<div class="section-title">
					<div class="section-icon"><i class="fa-regular fa-file"></i></div>
					<h3>Jenis Dokumen</h3>
				</div>
				<div class="doc-type-toggle">
					<input type="radio" name="document_type" id="type_invoice" class="radio-invoice" value="invoice" checked onchange="toggleDocType()">
					<label for="type_invoice"><i class="fa-solid fa-receipt"></i> Invoice</label>
					<input type="radio" name="document_type" id="type_quotation" class="radio-quotation" value="quotation" onchange="toggleDocType()">
					<label for="type_quotation"><i class="fa-solid fa-clipboard-list"></i> Penawaran Harga</label>
				</div>
				<div id="docTypeNotice" class="tip-text" style="margin-top: 0.75rem; display: none;">
					<i class="fa-solid fa-circle-info"></i> Mode <strong>Penawaran Harga</strong> — dokumen tidak menyertakan informasi rekening bank. Penawaran bisa dikonversi menjadi Invoice kapan saja.
				</div>
			</div>

			<!-- Informasi Perusahaan -->
			<div class="form-section">
				<div class="section-title">
					<div class="section-icon"><i class="fa-solid fa-building"></i></div>
					<h3>Informasi Perusahaan</h3>
				</div>
				<div class="form-row">
					<div class="form-group">
						<label for="company_id">Perusahaan <span class="required">*</span></label>
						<select id="company_id" name="company_id" required>
							<option value="">— Pilih Perusahaan —</option>
							<% companies.forEach(company => { %>
							<option value="<%= company.id %>"><%= company.name %></option>
							<% }); %>
						</select>
					</div>
				</div>
			</div>

			<!-- Informasi Nomor & Tanggal -->
			<div class="form-section">
				<div class="section-title">
					<div class="section-icon"><i class="fa-regular fa-calendar-days"></i></div>
					<h3 id="docTypeHeading">Informasi Invoice</h3>
				</div>
				<div class="form-row three-col">
					<div class="form-group">
						<label for="invoice_number">Nomor Dokumen <span class="required">*</span></label>
						<input
							type="text"
							id="invoice_number"
							name="invoice_number"
							placeholder="INV/RESPRO/001/11.2026"
							required
						/>
					</div>
					<div class="form-group">
						<label for="invoice_date">Tanggal <span class="required">*</span></label>
						<input type="date" id="invoice_date" name="invoice_date" required />
					</div>
					<div class="form-group">
						<label for="due_date" id="dueDateLabel">Tanggal Jatuh Tempo</label>
						<input type="date" id="due_date" name="due_date" />
					</div>
				</div>
				<div class="form-row">
					<div class="form-group">
						<label for="status">Status</label>
						<select id="status" name="status">
							<option value="draft">Draft</option>
							<option value="issued">Diterbitkan</option>
							<option value="sent">Terkirim</option>
							<option value="paid">Dibayar</option>
						</select>
					</div>
					<div class="form-group" id="statusQuotationGroup" style="display:none;">
						<label for="status_quotation">Status Penawaran</label>
						<select id="status_quotation" name="status_quotation">
							<option value="draft">Draft</option>
							<option value="sent">Terkirim</option>
							<option value="accepted">Diterima</option>
							<option value="rejected">Ditolak</option>
						</select>
					</div>
				</div>
			</div>

			<!-- Data Penerima -->
			<div class="form-section">
				<div class="section-title">
					<div class="section-icon"><i class="fa-regular fa-user"></i></div>
					<h3>Data Penerima</h3>
				</div>
				<div class="form-row full">
					<div class="form-group">
						<label for="customer_picker">Pilih dari Master Pelanggan <span style="font-weight:400; color: var(--text-muted); font-size:0.8rem;">(opsional)</span></label>
						<select id="customer_picker">
							<option value="">— Isi manual / pelanggan baru —</option>
							<% (typeof customers !== 'undefined' ? customers : []).forEach(c => { %>
							<option
								value="<%= c.id %>"
								data-name="<%= c.name %>"
								data-phone="<%= c.phone || '' %>"
								data-npwp="<%= c.npwp || '' %>"
								data-address="<%= c.address || '' %>"
							><%= c.name %><%= c.company ? ' — ' + c.company : '' %></option>
							<% }); %>
						</select>
						<p style="margin-top:0.35rem; font-size:0.78rem; color:var(--text-muted);">
							Memilih pelanggan akan mengisi kolom di bawah otomatis dan menautkan dokumen ke data pelanggan.
						</p>
					</div>
				</div>
				<input type="hidden" name="customer_id" id="customer_id" value="" />
				<div class="form-row">
					<div class="form-group">
						<label for="recipient_name">Nama <span class="required">*</span></label>
						<input
							type="text"
							id="recipient_name"
							name="recipient_name"
							placeholder="Nama lengkap / instansi"
							required
						/>
					</div>
					<div class="form-group">
						<label for="recipient_phone">Nomor Telepon</label>
						<input
							type="text"
							id="recipient_phone"
							name="recipient_phone"
							placeholder="08123456789"
						/>
					</div>
				</div>
				<div class="form-row">
					<div class="form-group">
						<label for="recipient_npwp">NPWP</label>
						<input
							type="text"
							id="recipient_npwp"
							name="recipient_npwp"
							placeholder="12.345.678.9-012.000"
						/>
					</div>
				</div>
				<div class="form-row full">
					<div class="form-group">
						<label for="recipient_address">Alamat</label>
						<textarea
							id="recipient_address"
							name="recipient_address"
							placeholder="Alamat lengkap penerima"
						></textarea>
					</div>
				</div>
			</div>

			<!-- Daftar Barang/Jasa dengan Grouping -->
			<div class="form-section">
				<div class="section-title">
					<div class="section-icon"><i class="fa-solid fa-box"></i></div>
					<h3>Daftar Barang / Jasa</h3>
				</div>
				<div class="tip-text">
					<i class="fa-solid fa-lightbulb"></i> <strong>Tips:</strong> Gunakan <strong>Group</strong> untuk mengelompokkan item (mis: I. Musik, II. FI). Copy group untuk menduplikat struktur yang mirip. Paste dari Excel langsung ke kolom Deskripsi.
				</div>

				<div class="items-section">
					<div id="itemsContainer"></div>

					<div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.75rem;">
						<button type="button" class="btn-add-group" onclick="addGroup()">
							+ Tambah Group
						</button>
						<button type="button" class="btn-add" onclick="addItem(null)">
							+ Tambah Item (tanpa group)
						</button>
					</div>
				</div>

				<input type="hidden" id="items" name="items" value="[]" />
			</div>

			<!-- Pajak & Biaya -->
			<div class="form-section">
				<div class="section-title">
					<div class="section-icon"><i class="fa-solid fa-chart-column"></i></div>
					<h3>Pajak & Biaya Tambahan <span style="font-weight:400; color: var(--text-muted); font-size:0.85rem;">(opsional)</span></h3>
				</div>
				<div class="items-section">
					<div id="taxesContainer"></div>
					<button type="button" class="btn-add" onclick="addTax()">
						+ Tambah Pajak / Biaya
					</button>
				</div>
				<input type="hidden" id="taxes" name="taxes" value="[]" />
			</div>

			<!-- Diskon -->
			<div class="form-section">
				<div class="section-title">
					<div class="section-icon"><i class="fa-solid fa-tag"></i></div>
					<h3>Diskon <span style="font-weight:400; color: var(--text-muted); font-size:0.85rem;">(opsional)</span></h3>
				</div>
				<div class="discount-section">
					<div class="discount-row">
						<div class="form-group">
							<label for="discount_type">Tipe Diskon</label>
							<select
								id="discount_type"
								name="discount_type"
								onchange="updateDiscountLabel()"
							>
								<option value="none">Tanpa Diskon</option>
								<option value="percentage">Persentase (%)</option>
								<option value="nominal">Nominal (Rp)</option>
							</select>
						</div>
						<div class="form-group">
							<label id="discountLabel" for="discount_value">Nilai Diskon</label>
							<input
								type="number"
								id="discount_value"
								name="discount_value"
								placeholder="0"
								value="0"
								min="0"
								step="0.01"
							/>
						</div>
					</div>
				</div>
			</div>

			<!-- Ringkasan Total -->
			<div class="form-section">
				<div class="section-title">
					<div class="section-icon"><i class="fa-solid fa-money-bill"></i></div>
					<h3>Ringkasan</h3>
				</div>
				<div class="summary-box">
					<div id="summarySection">
						<div class="summary-item">
							<span>Subtotal:</span>
							<strong>Rp 0</strong>
						</div>
						<div class="summary-item total">
							<span>Total:</span>
							<strong>Rp 0</strong>
						</div>
					</div>
				</div>
			</div>

			<!-- Actions -->
			<div class="form-actions">
				<button type="submit" class="btn-submit" id="submitBtn">
					<i class="fa-solid fa-floppy-disk"></i> Simpan Invoice
				</button>
				<a href="/admin/invoice/history" class="btn-cancel">
					Batal
				</a>
			</div>
		</form>
	</div>
</div>

<script src="/js/create-invoice.js"></script>
