<!DOCTYPE html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Admin Login - E-Invoice Restu Production</title>
		<link rel="stylesheet" href="/css/style.css" />
		<style>
			:root {
				--primary: #0356fc;
				--primary-dark: #0244cc;
				--secondary: #fc032d;
			}

			.login-container {
				min-height: 100vh;
				display: flex;
				justify-content: center;
				align-items: center;
				background: #f4f6fb;
			}

			.login-box {
				background: white;
				padding: 2.5rem;
				border-radius: 12px;
				box-shadow: 0 10px 30px rgba(3, 86, 252, 0.08);
				border: 1px solid #e5e7eb;
				width: 100%;
				max-width: 400px;
			}

			.login-box h2 {
				text-align: center;
				color: #1a1f36;
				margin-bottom: 0.25rem;
				font-size: 1.6rem;
				font-weight: 700;
			}

			.login-sub {
				text-align: center;
				color: #6b7280;
				font-size: 0.85rem;
				margin-bottom: 1.75rem;
			}

			.form-group {
				margin-bottom: 1.25rem;
			}

			.form-group label {
				display: block;
				margin-bottom: 0.4rem;
				color: #374151;
				font-weight: 500;
				font-size: 0.85rem;
			}

			.form-group input {
				width: 100%;
				padding: 0.75rem 0.85rem;
				border: 1px solid #d1d5db;
				border-radius: 6px;
				font-size: 0.95rem;
				box-sizing: border-box;
				transition: border-color 0.2s, box-shadow 0.2s;
			}

			.form-group input:focus {
				outline: none;
				border-color: var(--primary);
				box-shadow: 0 0 0 3px rgba(3, 86, 252, 0.1);
			}

			.login-btn {
				width: 100%;
				padding: 0.8rem;
				background: var(--primary);
				color: white;
				border: none;
				border-radius: 6px;
				font-size: 0.95rem;
				font-weight: 600;
				cursor: pointer;
				transition: background 0.2s, transform 0.1s;
			}

			.login-btn:hover {
				background: var(--primary-dark);
			}

			.login-btn:active {
				transform: translateY(1px);
			}

			.error {
				background-color: #fff0f2;
				color: var(--secondary);
				border: 1px solid #fca5a5;
				padding: 0.75rem;
				border-radius: 6px;
				margin-bottom: 1.25rem;
				text-align: center;
				font-size: 0.88rem;
			}

			.back-link {
				text-align: center;
				margin-top: 1.25rem;
			}

			.back-link a {
				color: var(--primary);
				text-decoration: none;
				font-size: 0.88rem;
				font-weight: 500;
			}

			.back-link a:hover {
				text-decoration: underline;
			}
		</style>
	</head>
	<body>
		<div class="login-container">
			<div class="login-box">
				<h2>Restu Production</h2>
				<p class="login-sub">Masuk ke Panel E-Invoice</p>

				<% if (error) { %>
				<div class="error"><%= error %></div>
				<% } %>

				<form action="/auth/login" method="POST">
					<div class="form-group">
						<label for="username">Username</label>
						<input
							type="text"
							id="username"
							name="username"
							placeholder="Masukkan username"
							required
						/>
					</div>

					<div class="form-group">
						<label for="password">Password</label>
						<input
							type="password"
							id="password"
							name="password"
							placeholder="Masukkan password"
							required
						/>
					</div>

					<input type="hidden" name="return" value="<%= returnUrl %>" />

					<button type="submit" class="login-btn">Masuk</button>
				</form>

				<div class="back-link">
					<a href="/">← Kembali ke Cek Invoice</a>
				</div>
			</div>
		</div>
	</body>
</html>
