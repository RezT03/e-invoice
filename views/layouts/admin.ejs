<!DOCTYPE html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		  <meta http-equiv="Content-Security-Policy" content="script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com;">
		<title><%= pageTitle %> - Admin Dashboard E-Invoice</title>
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
			integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg=="
			crossorigin="anonymous"
			referrerpolicy="no-referrer"
		/>
		<!-- Komponen tombol/badge dipakai semua halaman admin, dimuat sebelum layout -->
		<link rel="stylesheet" href="/css/admin-style.css" />
		<link rel="stylesheet" href="/css/admin-layout.css" />
		<% if (additionalStyles) { %> <% additionalStyles.forEach(style => { %>
		<link rel="stylesheet" href="/css/<%= style %>.css" />
		<% }); %> <% } %>
	</head>
	<body>
		<div class="admin-container">
			<!-- Sidebar Overlay -->
			<div class="sidebar-overlay" id="sidebarOverlay"></div>

			<!-- Sidebar -->
			<%- include('../partials/admin/sidebar', { currentPage }) %>

			<!-- Main Content -->
			<main class="main-content">
				<!-- Top Bar -->
				<%- include('../partials/admin/topbar', { 
					pageTitle, 
					userName: typeof userName !== 'undefined' ? userName : (typeof adminName !== 'undefined' ? adminName : 'Admin User'), 
					userInitial: typeof userInitial !== 'undefined' ? userInitial : 'A', 
					showUserInfo: typeof showUserInfo !== 'undefined' ? showUserInfo : true 
			}) %>

				<!-- Page Content -->
				<% if (contentFile) { %> <%- include('../pages/' + contentFile, locals)
				%> <% } else { %> <%- body %> <% } %>
			</main>
		</div>

		<!-- Scripts -->
		<script src="/js/utils.js"></script>
		<script src="/js/admin-sidebar.js"></script>
	</body>
</html>
