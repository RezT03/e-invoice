<!DOCTYPE html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title><%= title %></title>
		<link rel="icon" href="/img/favicon.ico" sizes="any" type="image/x-icon" />

		<!-- FontAwesome CDN 7.3.1 (Icons library) -->
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
			integrity="sha512-QeR2VH+lsBE5LSAe1Q5EnTBbe7XTBubt8dG93Y7gidSgdMCr8nVqKcfKAMyN96SV8KDbZVTDXChatu5G2KQGzg=="
			crossorigin="anonymous"
			referrerpolicy="no-referrer"
		/>

		<link rel="stylesheet" href="/css/style.css" />
	</head>
	<body>
		<header>
			<nav>
				<a href="/invoice/history">
					<i class="fas fa-list"></i>
					Riwayat Invoice
				</a>
				<% if (isAdmin) { %>
				<a href="/admin/invoice/create">
					<i class="fa-regular fa-plus-circle"></i>
					Buat Invoice
				</a>
				<a href="/auth/logout">
					<i class="fa-regular fa-sign-out-alt"></i>
					Logout
				</a>
				<% } else { %>
				<a href="/auth/login">
					<i class="fa-regular fa-sign-in-alt"></i>
					Login Admin
				</a>
				<% } %>
			</nav>
		</header>
		<main><%- body %></main>
	</body>
</html>

